# MiniDisc Manager (linux/setup.sh installs this as /etc/udev/rules.d/60-minidisc.rules).
# Lets the person signed in at the computer use MiniDisc recorders over USB without root - the Linux side of the
# "WinUSB driver with Zadig" step on Windows. Generated from the device lists in himd_dev.py (NetMD) and himd-js (Hi-MD).

# Hi-MD recorders in Hi-MD mode (USB mass storage). linux/setup.sh also tells usb-storage to ignore these.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="017f", TAG+="uaccess"  # Sony MZ-NH1
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0181", TAG+="uaccess"  # Sony MZ-NH3D
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0183", TAG+="uaccess"  # Sony MZ-NH900
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0185", TAG+="uaccess"  # Sony MZ-NH700
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0187", TAG+="uaccess"  # Sony MZ-NH600
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="018b", TAG+="uaccess"  # Sony LAM
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="01ea", TAG+="uaccess"  # Sony MZ-DH10P
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="021a", TAG+="uaccess"  # Sony MZ-RH10
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="021c", TAG+="uaccess"  # Sony MZ-RH910
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="022d", TAG+="uaccess"  # Sony CMT-AH10
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="023d", TAG+="uaccess"  # Sony DS-HMD1
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0287", TAG+="uaccess"  # Sony MZ-RH1

