# MiniDisc Manager (linux/setup.sh installs this as /etc/udev/rules.d/60-minidisc.rules) - the Linux side of the
# "WinUSB driver with Zadig" step on Windows. Generated from the device lists in himd_dev.py (NetMD) and himd-js (Hi-MD).
#
# Hi-MD recorders in Hi-MD mode are USB mass storage, so Linux would treat them as a USB drive. For these models:
#   1. the desktop never mounts the disc (UDISKS_IGNORE),
#   2. usb-storage is unbound from the recorder as soon as it takes it, so MiniDisc Manager can talk to it directly,
#   3. the person signed in at the computer may use the recorder without root (uaccess).
# (A usb-storage "quirks" option cannot be used: the kernel keeps only 127 characters of it, too few for all the models.)

# Sony MZ-NH1
SUBSYSTEM=="block", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="017f", ENV{UDISKS_IGNORE}="1"
ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", DRIVER=="usb-storage", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="017f", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/usb-storage/unbind'"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="017f", TAG+="uaccess"
# Sony MZ-NH3D
SUBSYSTEM=="block", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0181", ENV{UDISKS_IGNORE}="1"
ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", DRIVER=="usb-storage", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0181", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/usb-storage/unbind'"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0181", TAG+="uaccess"
# Sony MZ-NH900
SUBSYSTEM=="block", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0183", ENV{UDISKS_IGNORE}="1"
ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", DRIVER=="usb-storage", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0183", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/usb-storage/unbind'"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="054c", ATTR{idProduct}=="0183", TAG+="uaccess"
