+// rawRanges: [{first, last}] blocks (inclusive) used by the deleted tracks; keptRanges: the same for the fragments of the tracks that stay.
+// Returns the regions to free: [{firstBlock, length}]. The blocks of the deleted tracks are collected, every block a kept track still
+// uses (a neighbour shares its boundary block) is taken out, what is left is grouped into runs, and each run is trimmed to whole
+// 32 kB clusters (a block is 16 kB; one or two blocks per run can't be freed).
+function planFreeRegions(rawRanges, keptRanges) {
+    const doomed = new Set();
+    for (const r of rawRanges) for (let b = r.first; b <= r.last; b++) doomed.add(b);
+    for (const r of keptRanges) for (let b = r.first; b <= r.last; b++) doomed.delete(b);
+    const blocks = [...doomed].sort((a, b) => a - b);
+    const out = [];
+    for (let i = 0; i < blocks.length;) {
+        let j = i;
+        while (j + 1 < blocks.length && blocks[j + 1] === blocks[j] + 1) j++;
+        let first = blocks[i], length = j - i + 1;
+        if (first % 2 === 1) { first++; length--; }
+        if (length % 2 === 1) length--;
+        if (length > 0) out.push({ firstBlock: first, length });
+        i = j + 1;
+    }
+    // The caller moves every kept fragment down once per region, comparing the fragment's CURRENT block with the region's start, so the
+    // regions must come highest first: a block that has already moved down past a lower region's start must still count as above it.
+    return out.sort((a, b) => b.firstBlock - a.firstBlock);
